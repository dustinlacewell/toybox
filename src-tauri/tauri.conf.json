{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toybox",
  "version": "0.4.1",
  "identifier": "com.toybox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toybox — Asset Library",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ],
          "deny": []
        }
      },
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost plugin: http://plugin.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' plugin: http://plugin.localhost",
        "connect-src": "'self' asset: http://asset.localhost plugin: http://plugin.localhost ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
        "../plugins/com.toybox.audio-importer/icons": "plugins/com.toybox.audio-importer/icons",
        "../plugins/com.toybox.humanoid-rigs/icons": "plugins/com.toybox.humanoid-rigs/icons",
        "../plugins/com.toybox.gltf-importer/icons": "plugins/com.toybox.gltf-importer/icons",
        "../plugins/com.toybox.material-importer/icons": "plugins/com.toybox.material-importer/icons",
      "../plugins/com.toybox.audio-importer/manifest.json": "plugins/com.toybox.audio-importer/manifest.json",
      "../plugins/com.toybox.audio-importer/dist": "plugins/com.toybox.audio-importer/dist",
      "../plugins/com.toybox.humanoid-rigs/manifest.json": "plugins/com.toybox.humanoid-rigs/manifest.json",
      "../plugins/com.toybox.humanoid-rigs/dist": "plugins/com.toybox.humanoid-rigs/dist",
      "../plugins/com.toybox.gltf-importer/manifest.json": "plugins/com.toybox.gltf-importer/manifest.json",
      "../plugins/com.toybox.gltf-importer/dist": "plugins/com.toybox.gltf-importer/dist",
      "../plugins/com.toybox.material-importer/manifest.json": "plugins/com.toybox.material-importer/manifest.json",
      "../plugins/com.toybox.material-importer/dist": "plugins/com.toybox.material-importer/dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMjJDN0RBNkVCMDAwOEUKUldTT0FMQnUyc2Npc2REcGVhczJ4VmFGM0dSVTdKZjcxMlRRem94eExSSUd1MnpNSXdvS0lmTjAK",
      "endpoints": ["https://github.com/dustinlacewell/toybox/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
