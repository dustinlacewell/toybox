{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toybox",
  "version": "0.7.0",
  "identifier": "com.toybox.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toybox — Asset Library",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPCACHE/**"
          ],
          "deny": []
        }
      },
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost plugin: http://plugin.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' plugin: http://plugin.localhost",
        "connect-src": "'self' asset: http://asset.localhost plugin: http://plugin.localhost ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../plugins/com.toybox.model-core/icons": "plugins/com.toybox.model-core/icons",
      "../plugins/com.toybox.model-core/manifest.json": "plugins/com.toybox.model-core/manifest.json",
      "../plugins/com.toybox.model-core/dist": "plugins/com.toybox.model-core/dist",
      "../plugins/com.toybox.model-gltf/icons": "plugins/com.toybox.model-gltf/icons",
      "../plugins/com.toybox.model-gltf/manifest.json": "plugins/com.toybox.model-gltf/manifest.json",
      "../plugins/com.toybox.model-gltf/dist": "plugins/com.toybox.model-gltf/dist",
      "../plugins/com.toybox.animation-core/icons": "plugins/com.toybox.animation-core/icons",
      "../plugins/com.toybox.animation-core/manifest.json": "plugins/com.toybox.animation-core/manifest.json",
      "../plugins/com.toybox.animation-core/dist": "plugins/com.toybox.animation-core/dist",
      "../plugins/com.toybox.material-core/icons": "plugins/com.toybox.material-core/icons",
      "../plugins/com.toybox.material-core/manifest.json": "plugins/com.toybox.material-core/manifest.json",
      "../plugins/com.toybox.material-core/dist": "plugins/com.toybox.material-core/dist",
      "../plugins/com.toybox.material-sbsar/icons": "plugins/com.toybox.material-sbsar/icons",
      "../plugins/com.toybox.material-sbsar/manifest.json": "plugins/com.toybox.material-sbsar/manifest.json",
      "../plugins/com.toybox.material-sbsar/dist": "plugins/com.toybox.material-sbsar/dist",
      "../plugins/com.toybox.audio-core/icons": "plugins/com.toybox.audio-core/icons",
      "../plugins/com.toybox.audio-core/manifest.json": "plugins/com.toybox.audio-core/manifest.json",
      "../plugins/com.toybox.audio-core/dist": "plugins/com.toybox.audio-core/dist",
      "../plugins/com.toybox.skybox-core/icons": "plugins/com.toybox.skybox-core/icons",
      "../plugins/com.toybox.skybox-core/manifest.json": "plugins/com.toybox.skybox-core/manifest.json",
      "../plugins/com.toybox.skybox-core/dist": "plugins/com.toybox.skybox-core/dist",
      "../plugins/com.toybox.rig-synty-polygon/icons": "plugins/com.toybox.rig-synty-polygon/icons",
      "../plugins/com.toybox.rig-synty-polygon/manifest.json": "plugins/com.toybox.rig-synty-polygon/manifest.json",
      "../plugins/com.toybox.rig-synty-polygon/dist": "plugins/com.toybox.rig-synty-polygon/dist",
      "../plugins/com.toybox.rig-synty-sidekick/icons": "plugins/com.toybox.rig-synty-sidekick/icons",
      "../plugins/com.toybox.rig-synty-sidekick/manifest.json": "plugins/com.toybox.rig-synty-sidekick/manifest.json",
      "../plugins/com.toybox.rig-synty-sidekick/dist": "plugins/com.toybox.rig-synty-sidekick/dist",
      "../plugins/com.toybox.rig-synty-unreal/icons": "plugins/com.toybox.rig-synty-unreal/icons",
      "../plugins/com.toybox.rig-synty-unreal/manifest.json": "plugins/com.toybox.rig-synty-unreal/manifest.json",
      "../plugins/com.toybox.rig-synty-unreal/dist": "plugins/com.toybox.rig-synty-unreal/dist",
      "../plugins/com.toybox.rig-quaternius/icons": "plugins/com.toybox.rig-quaternius/icons",
      "../plugins/com.toybox.rig-quaternius/manifest.json": "plugins/com.toybox.rig-quaternius/manifest.json",
      "../plugins/com.toybox.rig-quaternius/dist": "plugins/com.toybox.rig-quaternius/dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMjJDN0RBNkVCMDAwOEUKUldTT0FMQnUyc2Npc2REcGVhczJ4VmFGM0dSVTdKZjcxMlRRem94eExSSUd1MnpNSXdvS0lmTjAK",
      "endpoints": ["https://github.com/dustinlacewell/toybox/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
