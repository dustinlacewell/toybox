{
  "id": "com.toybox.audio-core",
  "name": "Audio",
  "version": "2.0.0",
  "assetTypes": [
    { "id": "audio", "label": "Audio", "singular": "Sound", "icon": "icons/audio.svg", "implementation": "native", "tileAspectRatio": 2, "order": 40,
      "properties": [
        { "id": "duration", "label": "Duration", "path": "audio.duration", "unit": "s" },
        { "id": "sample-rate", "label": "Sample rate", "path": "audio.sampleRate", "unit": "Hz" },
        { "id": "channels", "label": "Channels", "path": "audio.channels" }
      ] }
  ],
  "icon": "icons/audio.svg",
  "description": "The Audio type of the library and its importer: import WAV, MP3, Ogg Vorbis and FLAC files with waveforms and audio metadata.",
  "permissions": { "fsRead": true, "fsWrite": true },
  "ui": { "importPanel": "dist/ui/Import.js" },
  "cli": {
    "module": "dist/cli.js",
    "importers": [
      {
        "name": "audio",
        "summary": "Import WAV, MP3, Ogg Vorbis and FLAC files.",
        "options": [
          { "name": "category", "type": "string", "default": "sounds", "help": "Category of the imported sounds." }
        ]
      }
    ]
  }
}
